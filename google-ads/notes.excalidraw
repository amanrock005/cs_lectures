      "updated": 1788851934283,
      "link": null,
      "locked": false,
      "text": "send confirmation message\nto user video is uploaded \nand processing can take time\n- transcoding is an async process\n- decoupling upload from transcoding\n- we are not blocking the user\n",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "send confirmation message\nto user video is uploaded \nand processing can take time\n- transcoding is an async process\n- decoupling upload from transcoding\n- we are not blocking the user\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "aabX59QAxdkn4-q-AcwLE",
      "type": "text",
      "x": -8086.998350090338,
      "y": -937.4808973229533,
      "width": 1408.93115234375,
      "height": 105,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBb",
      "roundness": null,
      "seed": 1065195360,
      "version": 225,
      "versionNonce": 1499029308,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788851934283,
      "link": null,
      "locked": false,
      "text": "This is a classical case of bounded queue + backpressuer\nbounded queue helps to identify that uploads are happening faster than the rate at which transcoding\nconsumers can consume it",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "This is a classical case of bounded queue + backpressuer\nbounded queue helps to identify that uploads are happening faster than the rate at which transcoding\nconsumers can consume it",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
