      "boundElements": null,
      "updated": 1788852544928,
      "link": null,
      "locked": false,
      "text": "non-functional requirements\n1. low latency: user search is < 200ms so relevant adds must be shown in the same duration\n2. scalable: high number of user searching\n3. consistency: once budget is exhausted do not run the campaign\n4. availability: if ads are down user is still able to search\n5. fairness: smaller brands and company get fair chance is sponsors ads slots\n6. freshness: do not show same products to every user",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "non-functional requirements\n1. low latency: user search is < 200ms so relevant adds must be shown in the same duration\n2. scalable: high number of user searching\n3. consistency: once budget is exhausted do not run the campaign\n4. availability: if ads are down user is still able to search\n5. fairness: smaller brands and company get fair chance is sponsors ads slots\n6. freshness: do not show same products to every user",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
