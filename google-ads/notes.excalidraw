    {
      "id": "WqpR1hkP-Me4v_90_zZt1",
      "type": "text",
      "x": -1763.2565822975268,
      "y": 55.75191205853082,
      "width": 1061.3392333984375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
