      "seed": 1932028576,
      "version": 8,
      "versionNonce": 847252100,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788851934283,
      "link": null,
      "locked": false,
      "text": "Subscriptions: \"User A subscribes to Channel B.\" At YouTube's scale, some channels have 100M+ subscribers. \nIf User A's homepage needs to show \"latest videos from channels I'm subscribed to,\"\n how would you design this so it's fast — do you query subscriptions live, or \nprecompute something? ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Subscriptions: \"User A subscribes to Channel B.\" At YouTube's scale, some channels have 100M+ subscribers. \nIf User A's homepage needs to show \"latest videos from channels I'm subscribed to,\"\n how would you design this so it's fast — do you query subscriptions live, or \nprecompute something? ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
