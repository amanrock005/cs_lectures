      "isDeleted": true,
      "boundElements": [],
      "updated": 1788851934283,
      "link": null,
      "locked": false,
      "text": "where can youtube break?\n- if user upload videos at higher rate(producer) than the rate at which transcoding takes place(consumer) so the message queue can fillup completely?",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "where can youtube break?\n- if user upload videos at higher rate(producer) than the rate at which transcoding takes place(consumer) so the message queue can fillup completely?",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "JWTkT9TWSkrjsxAk9tn7a",
      "type": "text",
      "x": -8085.252205536354,
      "y": -791.5761600832403,
      "width": 703.7796630859375,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffffff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bAS",
      "roundness": null,
      "seed": 970844000,
      "version": 352,
      "versionNonce": 2128218812,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1788851934283,
      "link": null,
      "locked": false,
      "text": "2.   decouple upload from transcoding\n\n3.   autoscale consumers\n\n4.   rate limit producers\n\n5.   priority/tiered queue\n\n6.  parition the queue based on user_id or video_id",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2.   decouple upload from transcoding\n\n3.   autoscale consumers\n\n4.   rate limit producers\n\n5.   priority/tiered queue\n\n6.  parition the queue based on user_id or video_id",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
