    {
      "id": "mJBQJ05IsgEiJRkncekFZ",
      "type": "text",
      "x": -5458.865498654304,
      "y": 3324.100690557369,
      "width": 1962.647705078125,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b9J",
      "roundness": null,
      "seed": 923429958,
      "version": 344,
      "versionNonce": 1760538906,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788078279737,
      "link": null,
      "locked": false,
      "text": "in case of livestreams all the users must be notified regardless of the subscriber count then how does youtube\n handle those notification and feed update?\n\nLive stream videos are also treated the same way like a regular upload\n\nfor smaller channel: fan-out-on-write\nfor celebrity channel: fan-out-on-read\n\n\nThe positioning of the live stream in a user feed is different since all live streams are \ndisplayed on the top of the feed",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "in case of livestreams all the users must be notified regardless of the subscriber count then how does youtube\n handle those notification and feed update?\n\nLive stream videos are also treated the same way like a regular upload\n\nfor smaller channel: fan-out-on-write\nfor celebrity channel: fan-out-on-read\n\n\nThe positioning of the live stream in a user feed is different since all live streams are \ndisplayed on the top of the feed",
      "autoResize": true,
      "lineHeight": 1.25
    },
