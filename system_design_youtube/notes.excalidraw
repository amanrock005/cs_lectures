    {
      "id": "Q4Ecm0BzXt62V8D3jn2AC",
      "type": "text",
      "x": -1818.3243661036706,
      "y": 2483.915627147994,
      "width": 1485.47900390625,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b6S",
      "roundness": null,
      "seed": 1334945440,
      "version": 485,
      "versionNonce": 1384668000,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787335556364,
      "link": null,
      "locked": false,
      "text": "A user can save videos to 'Watch Later' or create custom playlists. How would you model this in your database? Would you use SQL or NoSQL, and why?\n\nMaintaining playlist SQL is a better solution\n\n1. If a video is added we want consistency which mean the video shows up immediately in the playlist\n2. It is ordered exactly how the user has added them or rearranged them\n3. If the owner of the video removes it the playlist video is pointing to nothing so that the playlist doesn't crashes",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A user can save videos to 'Watch Later' or create custom playlists. How would you model this in your database? Would you use SQL or NoSQL, and why?\n\nMaintaining playlist SQL is a better solution\n\n1. If a video is added we want consistency which mean the video shows up immediately in the playlist\n2. It is ordered exactly how the user has added them or rearranged them\n3. If the owner of the video removes it the playlist video is pointing to nothing so that the playlist doesn't crashes",
      "autoResize": true,
      "lineHeight": 1.25
    },
