      "boundElements": null,
      "updated": 1787229032133,
      "link": null,
      "locked": false,
      "text": "zomato server batches \nsends batched device \ntokens",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "zomato server batches \nsends batched device \ntokens",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "EJf9K0Y1E1dUmmrlCRc0a",
      "type": "text",
      "x": 114.82378481426679,
      "y": 1322.2745726107182,
      "width": 529.479736328125,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "_HuCzUXKllJyssaINdXEM"
      ],
      "frameId": null,
      "index": "b5VG",
      "roundness": null,
      "seed": 836247648,
      "version": 492,
      "versionNonce": 197209504,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787228876493,
      "link": null,
      "locked": false,
      "text": "// Single Batched Request (Efficient)\nPOST /v1/projects/zomato/messages:sendBatch\n{\n  \"tokens\": [\n    \"device_token_1\",\n    \"device_token_2\",\n    \"device_token_3\",\n    \"...up to 500 tokens...\"\n  ],\n  \"notification\": {\n    \"title\": \"50% Off Sale!\",\n    \"body\": \"Order now from top restaurants near you.\"\n  }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Single Batched Request (Efficient)\nPOST /v1/projects/zomato/messages:sendBatch\n{\n  \"tokens\": [\n    \"device_token_1\",\n    \"device_token_2\",\n    \"device_token_3\",\n    \"...up to 500 tokens...\"\n  ],\n  \"notification\": {\n    \"title\": \"50% Off Sale!\",\n    \"body\": \"Order now from top restaurants near you.\"\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "R2fUZMWZn0av3zLKRlECu",
      "type": "text",
      "x": 742.251645757978,
      "y": 1310.6894115652067,
      "width": 434.69976806640625,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
