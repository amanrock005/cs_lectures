    {
      "id": "rbt6Q43k8K41uVnh2j6Al",
      "type": "text",
      "x": 102.99472908145015,
      "y": 856.8266982134089,
      "width": 872.4393310546875,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5U",
      "roundness": null,
      "seed": 918775200,
      "version": 577,
      "versionNonce": 1892710816,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787228884546,
      "link": null,
      "locked": false,
      "text": "- FCN/APN acts as bridge between company's backend servers and users\n- FCN is google service to send notification\n- APN is apple service to send notification\n- FCN redirects notification to APN for iOS/mac devices\n- device token (registration token) a unique long string of letters and numbers generated\nwhen a user install the app\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "- FCN/APN acts as bridge between company's backend servers and users\n- FCN is google service to send notification\n- APN is apple service to send notification\n- FCN redirects notification to APN for iOS/mac devices\n- device token (registration token) a unique long string of letters and numbers generated\nwhen a user install the app\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "1HZPkfDZpPbQ-78wZHgzD",
      "type": "text",
      "x": 75.6477459668792,
      "y": 623.5160171688326,
      "width": 231.2998504638672,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b5V",
