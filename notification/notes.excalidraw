      "roundness": null,
      "seed": 609161632,
      "version": 593,
      "versionNonce": 42629536,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1787228876493,
      "link": null,
      "locked": false,
      "text": "// Request 1 of 500 (Inefficient)\nPOST /v1/projects/zomato/messages:send\n{\n  \"message\": {\n    \"token\": \"device_token_1\",\n    \"notification\": { \"title\": \"50% Off Sale!\" }\n  }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "// Request 1 of 500 (Inefficient)\nPOST /v1/projects/zomato/messages:send\n{\n  \"message\": {\n    \"token\": \"device_token_1\",\n    \"notification\": { \"title\": \"50% Off Sale!\" }\n  }\n}",
      "autoResize": true,
      "lineHeight": 1.25
    },
